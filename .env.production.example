# ==============================================================================
# DAB — Production Environment Configuration Template
# ==============================================================================

# Core Application Settings
PROJECT_NAME="DAB Analytical Engine"
ENVIRONMENT="production"  # 'production' enforces strict JWT verification and rejects unauthenticated requests
DEBUG=false
SECRET_KEY="generate-a-strong-random-secret-key-at-least-32-chars"

# Database Configuration (PostgreSQL recommended for production)
# PostgreSQL format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# SQLite format (local/testing): sqlite:///./dab_local.db
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# CORS Security (Comma-separated exact origins; no wildcard * when credentials are enabled)
CORS_ORIGINS="https://dab.yourdomain.com,https://app.yourdomain.com"

# Local Storage Paths
UPLOAD_DIR="./data/uploads"
REPORTS_DIR="./data/reports"
MAX_UPLOAD_SIZE_BYTES=26214400  # 25 MB

# ==============================================================================
# Supabase Authentication & Private Storage Configuration
# ==============================================================================
# Found in Supabase Dashboard -> Project Settings -> API & Authentication

# Project API URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# Supabase Anon Public Key (used by frontend client)
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (kept strictly secret on server for storage and administrative calls)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase JWT Secret (Found in Project Settings -> API -> JWT Settings -> JWT Secret)
# Used by FastAPI backend to verify incoming Bearer tokens using HMAC-SHA256
SUPABASE_JWT_SECRET=""
SUPABASE_JWT_ALGORITHM="ES256"

# Supabase Private Storage Bucket Names
SUPABASE_DATASETS_BUCKET="dab-datasets"
SUPABASE_REPORTS_BUCKET="dab-reports"

# ==============================================================================
# Frontend Environment Variables (Vite client)
# Note: In Vite, variables prefixed with VITE_ are exposed to client bundle.
# ==============================================================================
VITE_API_BASE_URL="/api"
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
